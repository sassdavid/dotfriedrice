{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "API_TIMEOUT_MS": "1800000",
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "CLAUDE_STREAM_IDLE_TIMEOUT_MS": "600000",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_UPDATES": "1",
    "DO_NOT_TRACK": "1",
    "FORCE_AUTOUPDATE_PLUGINS": "1",
    "MCP_PROTOCOL_NEGOTIATION": "auto"
  },
  "attribution": false,
  "permissions": {
    "defaultMode": "auto"
  },
  "enabledMcpjsonServers": [
    "terraform"
  ],
  "deniedMcpServers": [
    {
      "serverName": "plugin:aws-core:aws-mcp"
    },
    {
      "serverName": "plugin:aws-data-analytics:aws-mcp"
    }
  ],
  "bashOutputMaxChars": 60000,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 10
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "~/.claude/subagent-statusline.sh"
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "document-skills@anthropic-agent-skills": true,
    "frontend-design@claude-plugins-official": true,
    "aws-core@claude-plugins-official": true,
    "aws-data-analytics@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      },
      "autoUpdate": true
    }
  },
  "skipWebFetchPreflight": true,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "theme": "auto"
}
