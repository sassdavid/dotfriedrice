# vpn-connect profiles.
#
#   cp profiles.conf.example "${XDG_CONFIG_HOME:-$HOME/.config}/vpn-connect/profiles.conf"
#
# profiles.conf is gitignored: endpoint IDs, account names and connection names are
# environment-specific and must not be committed. VPN_CONNECT_CONFIG overrides the location.
#
# Parsed literally, never sourced or eval'd, so only `key = value` lines inside a [section]
# are read and a stray line cannot execute. `#` and `;` start a comment. The first section is
# the default profile, used when `vpn` is run with no argument.
#
# Keys
# ----
#   kind        viscosity (default) | aws-clientvpn
#   connection  The connection name as Viscosity shows it. Required, except for an
#               aws-clientvpn profile using name-template.
#   auth        op-dialog | web | none. Defaults to op-dialog for viscosity, web for
#               aws-clientvpn.
#                 op-dialog  Read credentials from 1Password and type them into Viscosity's
#                            credential dialog via Accessibility.
#                 web        Viscosity authenticates itself (AWS SAML browser flow).
#                 none       No interactive authentication (client certificate only).
#   timeout     Seconds to wait for the connection. Default 30. Allow minutes for `web`,
#               which waits on a browser login.
#
# auth = op-dialog
#   op-item     Required. 1Password item title holding the credentials and TOTP.
#   op-vault    Vault to search. Recommended: without it `op` searches every vault, which is
#               slower and ambiguous when item titles repeat.
#   op-account  Account to use, when several are signed in.
#   otp-mode    append (default) | challenge | none
#                 append     Concatenate the TOTP onto the password in one field.
#                 challenge  Type the TOTP into a separate third field, for a config
#                            carrying `static-challenge`.
#                 none       Do not fetch a TOTP.
#
# kind = aws-clientvpn
#   aws-profile  Required. AWS CLI profile name.
#   aws-region   Required. Region the endpoint lives in. One section per account and region:
#               a project split across regions needs one section per region.
#
#   Then either name every endpoint in that account and region at once...
#   name-template  A pattern of {TagKey} placeholders naming each endpoint from its own tags.
#                  "{Project}-{Stack}" names an endpoint tagged Project=acme, Stack=dev3 as
#                  "acme-dev3". Endpoints missing a referenced tag are skipped. A new
#                  endpoint needs no edit here. Cannot be combined with connection,
#                  endpoint-id or endpoint-tag.
#
#   ...or pin exactly one, which also needs `connection`:
#   endpoint-id    The cvpn-endpoint-... id.
#   endpoint-tag   KEY=VALUE to resolve the endpoint by, so the id can change without editing
#                  this file. Must match exactly one endpoint.
#
# Endpoints are listed whatever their AWS status. pending-associate means no target network
# is attached, so --sync works but connecting fails until someone associates a subnet;
# --discover shows the status and --sync warns about it.
#
# --sync also reads the Route 53 private zones attached to the endpoint's VPC and writes them
# into the connection as DNS search domains. AWS can push a DNS server but not a domain, and
# without one macOS never queries the VPN resolver, leaving private names unresolvable. This
# needs route53:ListHostedZonesByVPC; without it --sync warns and imports anyway.
#
#   vpn --discover          every endpoint and the name it would import as
#   vpn --discover acme     only profiles starting with "acme"
#   vpn --sync acme-dev3    import one endpoint into Viscosity
#   vpn acme-dev3           connect to it

[work]
kind       = viscosity
connection = Corp-VPN-Split
auth       = op-dialog
op-item    = Corp VPN
op-vault   = Private
otp-mode   = append
timeout    = 30

[work-full]
kind       = viscosity
connection = Corp-VPN-Full
auth       = op-dialog
op-item    = Corp VPN
op-vault   = Private

# Covers every endpoint in this account and region. Endpoints tagged Project=acme with
# Stack=dev2/dev3 become the connection names "acme-dev2" and "acme-dev3". Add {Department}
# when one stack has several endpoints that {Project}-{Stack} alone cannot tell apart.
[acme-dev]
kind          = aws-clientvpn
aws-profile   = my-aws-profile
aws-region    = eu-west-1
name-template = {Project}-{Stack}
auth          = web
timeout       = 180

# One pinned endpoint under a name of your choosing. Also how you break a tie when two
# endpoints expand to the same template name: a pinned endpoint drops out of discovery,
# which makes the remaining name unambiguous again.
[acme-prod]
kind        = aws-clientvpn
aws-profile = my-aws-prod-profile
aws-region  = eu-west-1
endpoint-id = cvpn-endpoint-0123456789abcdef0
connection  = acme-prod
auth        = web
timeout     = 180
