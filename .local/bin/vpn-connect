#!/usr/bin/env -S usage bash
# Requires: usage CLI  https://github.com/jdx/usage
#   Install: mise use -g usage   |   cargo install usage-cli
# shellcheck shell=bash
# shellcheck enable=add-default-case,avoid-negated-conditions,avoid-nullary-conditions,check-unassigned-uppercase,deprecate-which,quote-safe-variables,require-double-brackets,require-variable-braces,useless-use-of-cat

#USAGE name "vpn-connect"
#USAGE bin "vpn-connect"
#USAGE about "Control Viscosity VPN connections, including AWS Client VPN endpoints."
#USAGE long_about "macOS only, and Viscosity must be running.\n\nEvery environment-specific value lives in ~/.config/vpn-connect/profiles.conf, outside the dotfiles repo. See profiles.conf.example for the format, or point VPN_CONNECT_CONFIG somewhere else.\n\nA 'kind = viscosity' profile drives a connection Viscosity already has. Its credentials and a live TOTP come from 1Password and are typed into the credential dialog through macOS Accessibility, which your terminal needs access to under System Settings > Privacy & Security > Accessibility.\n\nA 'kind = aws-clientvpn' profile describes an AWS Client VPN endpoint. --sync downloads its configuration and imports it into Viscosity under a name you control, and Viscosity then handles authentication itself, whether SAML in the browser or a client certificate, so nothing is typed.\n\nOne aws-clientvpn profile can cover many endpoints: set name-template to build each connection name from the endpoint's own tags, and a newly created endpoint needs no config change. --discover shows what a template resolves to.\n\nRequires bash >= 5.0, plus jq and op for 1Password profiles and the AWS CLI for aws-clientvpn profiles."
#USAGE unknown_flags "error"
#USAGE arg "[target]" help="Profile name, or a connection name Viscosity already has. Defaults to the first profile. With --discover, a profile name prefix."
#USAGE flag "-s --status" help="Show the state of every Viscosity connection"
#USAGE flag "-d --down" help="Disconnect <target>, or every connection with --all"
#USAGE flag "--sync" help="Download an AWS Client VPN configuration and import it into Viscosity"
#USAGE flag "--discover" help="List AWS Client VPN endpoints and the names they would import as, optionally limited to profiles starting with <target>"
#USAGE flag "-l --list" help="List the configured profiles"
#USAGE flag "--all" requires="--down" help="With --down, disconnect every connection"
#USAGE flag "--complete-targets" hide=#true help="Print tab-completion candidates"
#USAGE group "action" "--status" "--down" "--sync" "--discover" "--list" "--complete-targets"
#USAGE complete "target" run="vpn-connect --complete-targets"
#USAGE example "vpn-connect" header="Connect using the first profile"
#USAGE example "vpn-connect work-full" header="Connect using a named profile"
#USAGE example "vpn-connect acme-dev3" header="Connect using a template-derived connection name"
#USAGE example "vpn-connect --status" header="Show the state of every connection"
#USAGE example "vpn-connect --down work-full" header="Disconnect one profile, leaving the others up"
#USAGE example "vpn-connect --down --all" header="Disconnect everything"
#USAGE example "vpn-connect --discover" header="List AWS endpoints and the names they would import as"
#USAGE example "vpn-connect --discover acme" header="List only the endpoints of profiles starting with acme"
#USAGE example "vpn-connect --sync acme-dev3" header="Import one AWS endpoint into Viscosity"

# No plain comments inside the #USAGE block: usage stops collecting at the first
# non-#USAGE line and silently drops the rest.

set -o errexit
set -o pipefail
set -o nounset
# Without this, errexit does not apply inside $( ), so a function that fails there runs on
# and reports a misleading second error instead of the first one.
shopt -s inherit_errexit

if ((BASH_VERSINFO[0] < 5)); then
  printf 'vpn-connect: requires bash >= 5.0, found %s\n' "${BASH_VERSION}" >&2
  exit 1
fi

readonly DEFAULT_TIMEOUT=30
readonly WEB_AUTH_TIMEOUT=180
readonly IMPORT_TIMEOUT=30
CONFIG_FILE="${VPN_CONNECT_CONFIG:-${XDG_CONFIG_HOME:-${HOME}/.config}/vpn-connect/profiles.conf}"
readonly CONFIG_FILE

PROFILE_NAME=""
PROFILE_KIND=""
PROFILE_CONNECTION=""
PROFILE_AUTH=""
PROFILE_OP_ITEM=""
PROFILE_OP_VAULT=""
PROFILE_OP_ACCOUNT=""
PROFILE_OTP_MODE=""
PROFILE_AWS_PROFILE=""
PROFILE_AWS_REGION=""
PROFILE_ENDPOINT_ID=""
PROFILE_ENDPOINT_TAG=""
PROFILE_NAME_TEMPLATE=""
PROFILE_TIMEOUT=""

SNAPSHOT=""
SNAPSHOT_LOADED=false

if [[ -t 2 && -z "${NO_COLOR:-}" ]]; then
  readonly C_GREEN=$'\033[0;32m'
  readonly C_RED=$'\033[0;31m'
  readonly C_YELLOW=$'\033[1;33m'
  readonly C_RESET=$'\033[0m'
else
  readonly C_GREEN="" C_RED="" C_YELLOW="" C_RESET=""
fi

log_info() { printf '%s[INFO]%s %s\n' "${C_GREEN}" "${C_RESET}" "${1}" >&2; }
log_warn() { printf '%s[WARN]%s %s\n' "${C_YELLOW}" "${C_RESET}" "${1}" >&2; }
log_error() { printf '%s[ERROR]%s %s\n' "${C_RED}" "${C_RESET}" "${1}" >&2; }

die() {
  log_error "${1}"
  exit "${2:-1}"
}

# Removed by the single EXIT trap main installs. make_tmpdir assigns instead of printing:
# called as $(make_tmpdir) the append would land in a subshell and be lost.
TMPDIRS=()
TMPDIR_LAST=""

make_tmpdir() {
  TMPDIR_LAST=$(mktemp -d) || die "Could not create a temporary directory"
  TMPDIRS+=("${TMPDIR_LAST}")
}

cleanup() {
  ((${#TMPDIRS[@]} == 0)) || rm -rf "${TMPDIRS[@]}"
}

require_macos() {
  [[ "${OSTYPE}" == darwin* ]] ||
    die "vpn-connect only runs on macOS: Viscosity and osascript are macOS-only."
}

require_command() {
  command -v "${1}" >/dev/null 2>&1 ||
    die "Required command not found in PATH: ${1}"
}

require_viscosity() {
  pgrep -x Viscosity >/dev/null 2>&1 ||
    die "Viscosity is not running. Launch it first."
}

require_config() {
  [[ -r "${CONFIG_FILE}" ]] ||
    die "Profiles file not found: ${CONFIG_FILE}
Copy profiles.conf.example there and fill in your own values."
}

# --- profiles file -----------------------------------------------------------------------

# Emits "key<TAB>value" for one section, or "section<TAB>key<TAB>value" for all of them.
# The file is read literally and never sourced, so a malformed line cannot execute.
parse_config() {
  local -r want="${1:-}"
  awk -v want="${want}" '
    /^[[:space:]]*[#;]/ { next }
    /^[[:space:]]*$/    { next }
    /^[[:space:]]*\[/ {
      section = $0
      sub(/^[[:space:]]*\[[[:space:]]*/, "", section)
      sub(/[[:space:]]*\].*$/, "", section)
      next
    }
    {
      line = $0
      sub(/[[:space:]]*[#;].*$/, "", line)
      if (index(line, "=") == 0) next
      key = substr(line, 1, index(line, "=") - 1)
      val = substr(line, index(line, "=") + 1)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)
      if (key == "") next
      if (want == "") { print section "\t" key "\t" val }
      else if (section == want) { print key "\t" val }
    }
  ' "${CONFIG_FILE}"
}

list_profiles() {
  awk '
    /^[[:space:]]*\[/ {
      s = $0
      sub(/^[[:space:]]*\[[[:space:]]*/, "", s)
      sub(/[[:space:]]*\].*$/, "", s)
      if (s != "") print s
    }
  ' "${CONFIG_FILE}"
}

is_profile() {
  list_profiles | grep -qxF -- "${1}"
}

# "connection<TAB>profile" for profiles that name exactly one connection. Reading the file
# directly avoids running load_profile's validation over unrelated sections.
profile_connections() {
  parse_config | awk -F'\t' '$2 == "connection" && $3 != "" { print $3 "\t" $1 }'
}

load_profile() {
  local name="${1:-}"

  if [[ -z "${name}" ]]; then
    # Taking the first line without `head` keeps the producer from being closed early,
    # which pipefail would otherwise turn into a failure.
    name=$(list_profiles)
    name="${name%%$'\n'*}"
    [[ -n "${name}" ]] || die "No profiles defined in ${CONFIG_FILE}"
  fi

  is_profile "${name}" ||
    die "Unknown profile: '${name}'. Run '${0##*/} --list' to see them."

  PROFILE_NAME="${name}"
  PROFILE_KIND="viscosity"
  PROFILE_CONNECTION=""
  PROFILE_AUTH=""
  PROFILE_OP_ITEM=""
  PROFILE_OP_VAULT=""
  PROFILE_OP_ACCOUNT=""
  PROFILE_OTP_MODE="append"
  PROFILE_AWS_PROFILE=""
  PROFILE_AWS_REGION=""
  PROFILE_ENDPOINT_ID=""
  PROFILE_ENDPOINT_TAG=""
  PROFILE_NAME_TEMPLATE=""
  PROFILE_TIMEOUT="${DEFAULT_TIMEOUT}"

  local key value
  while IFS=$'\t' read -r key value; do
    case "${key}" in
    kind) PROFILE_KIND="${value}" ;;
    connection) PROFILE_CONNECTION="${value}" ;;
    auth) PROFILE_AUTH="${value}" ;;
    op-item) PROFILE_OP_ITEM="${value}" ;;
    op-vault) PROFILE_OP_VAULT="${value}" ;;
    op-account) PROFILE_OP_ACCOUNT="${value}" ;;
    otp-mode) PROFILE_OTP_MODE="${value}" ;;
    aws-profile) PROFILE_AWS_PROFILE="${value}" ;;
    aws-region) PROFILE_AWS_REGION="${value}" ;;
    endpoint-id) PROFILE_ENDPOINT_ID="${value}" ;;
    endpoint-tag) PROFILE_ENDPOINT_TAG="${value}" ;;
    name-template) PROFILE_NAME_TEMPLATE="${value}" ;;
    timeout) PROFILE_TIMEOUT="${value}" ;;
    *) log_warn "[${name}] ignoring unknown key: ${key}" ;;
    esac
  done < <(parse_config "${name}")

  case "${PROFILE_KIND}" in
  viscosity)
    [[ -n "${PROFILE_CONNECTION}" ]] || die "[${name}] missing required key: connection"
    ;;
  aws-clientvpn)
    [[ -n "${PROFILE_AWS_PROFILE}" ]] || die "[${name}] aws-clientvpn requires: aws-profile"
    [[ -n "${PROFILE_AWS_REGION}" ]] || die "[${name}] aws-clientvpn requires: aws-region"
    if [[ -n "${PROFILE_NAME_TEMPLATE}" ]]; then
      [[ -z "${PROFILE_ENDPOINT_ID}${PROFILE_ENDPOINT_TAG}" ]] ||
        die "[${name}] name-template discovers endpoints, so it cannot be combined with endpoint-id or endpoint-tag"
    else
      [[ -n "${PROFILE_CONNECTION}" ]] ||
        die "[${name}] aws-clientvpn requires either name-template, or connection plus endpoint-id/endpoint-tag"
      [[ -n "${PROFILE_ENDPOINT_ID}${PROFILE_ENDPOINT_TAG}" ]] ||
        die "[${name}] aws-clientvpn requires one of: endpoint-id, endpoint-tag, name-template"
    fi
    [[ -n "${PROFILE_AUTH}" ]] || PROFILE_AUTH="web"
    ;;
  *) die "[${name}] unknown kind: '${PROFILE_KIND}' (expected viscosity or aws-clientvpn)" ;;
  esac

  [[ -n "${PROFILE_AUTH}" ]] || PROFILE_AUTH="op-dialog"

  case "${PROFILE_AUTH}" in
  op-dialog)
    [[ -n "${PROFILE_OP_ITEM}" ]] || die "[${name}] auth = op-dialog requires: op-item"
    case "${PROFILE_OTP_MODE}" in
    append | challenge | none) : ;;
    *) die "[${name}] unknown otp-mode: '${PROFILE_OTP_MODE}' (expected append, challenge or none)" ;;
    esac
    ;;
  web | none) : ;;
  *) die "[${name}] unknown auth: '${PROFILE_AUTH}' (expected op-dialog, web or none)" ;;
  esac

  [[ "${PROFILE_TIMEOUT}" =~ ^[0-9]+$ ]] ||
    die "[${name}] timeout must be a whole number of seconds, got: '${PROFILE_TIMEOUT}'"
}

# --- Viscosity ---------------------------------------------------------------------------

report_applescript_error() {
  log_error "${1}"
  printf '%s\n' "${2}" >&2
  if [[ "${2}" == *"-1743"* || "${2}" == *"not allowed"* ]]; then
    log_error "Grant your terminal app Automation access to Viscosity in"
    log_error "System Settings > Privacy & Security > Automation."
  fi
}

# "name<TAB>state<TAB>timeConnected" for every connection. Viscosity rejects
# `connection "NAME"` with -10002, and walking `connections` costs an Apple Event per
# property, so this fetches three property lists and joins them in AppleScript.
viscosity_snapshot() {
  local out status=0
  out=$(
    osascript <<'APPLESCRIPT' 2>&1
tell application "Viscosity"
  set theNames to name of every connection
  set theStates to state of every connection
  set theTimes to timeConnected of every connection
end tell
set outText to ""
repeat with i from 1 to (count of theNames)
  if i > 1 then set outText to outText & linefeed
  set outText to outText & (item i of theNames) & tab & (item i of theStates) & tab & (item i of theTimes)
end repeat
return outText
APPLESCRIPT
  ) || status=$?

  ((status == 0)) || {
    report_applescript_error "Could not query Viscosity:" "${out}"
    return 1
  }
  printf '%s\n' "${out}"
}

# Queries Viscosity once per run. connection_state and connection_time read the cached
# result, so a command substitution around them cannot lose the error or the cache.
load_snapshot() {
  [[ "${SNAPSHOT_LOADED}" != true ]] || return 0
  SNAPSHOT=$(viscosity_snapshot) || return 1
  SNAPSHOT_LOADED=true
}

# Prints the state of one connection, or "Missing" when Viscosity does not know the name.
connection_state() {
  local -r conn="${1}"
  local name state rest
  while IFS=$'\t' read -r name state rest; do
    if [[ "${name}" == "${conn}" ]]; then
      printf '%s' "${state}"
      return 0
    fi
  done <<<"${SNAPSHOT}"
  printf 'Missing'
}

connection_time() {
  local -r conn="${1}"
  local name state time
  while IFS=$'\t' read -r name state time; do
    if [[ "${name}" == "${conn}" ]]; then
      printf '%s' "${time}"
      return 0
    fi
  done <<<"${SNAPSHOT}"
}

# verb is connect, disconnect or disconnectall.
viscosity_command() {
  local out status=0
  out=$(
    osascript - "$@" <<'APPLESCRIPT' 2>&1
on run argv
  set theVerb to item 1 of argv
  tell application "Viscosity"
    if theVerb is "connect" then
      connect (item 2 of argv)
    else if theVerb is "disconnect" then
      disconnect (item 2 of argv)
    else
      disconnectall
    end if
  end tell
end run
APPLESCRIPT
  ) || status=$?

  ((status == 0)) || {
    report_applescript_error "Viscosity rejected '${1}':" "${out}"
    return 1
  }
}

# Polls inside one AppleScript so the wait costs a single process. Prints Connected,
# Failed or Timeout. Reaching Connecting and then falling back to Disconnected is a
# failure, reported at once rather than after the full timeout.
wait_for_connected() {
  local out status=0
  out=$(
    osascript - "${1}" "${2}" <<'APPLESCRIPT' 2>&1
on run argv
  set connName to item 1 of argv
  set deadline to (current date) + ((item 2 of argv) as integer)
  set sawProgress to false
  repeat
    set theState to "Missing"
    try
      tell application "Viscosity"
        set theState to state of (first connection whose name is connName)
      end tell
    end try
    if theState is "Connected" then return "Connected"
    if (theState is "Disconnected") and sawProgress then return "Failed"
    if (theState is not "Disconnected") and (theState is not "Missing") then
      set sawProgress to true
    end if
    if (current date) > deadline then return "Timeout"
    delay 1
  end repeat
end run
APPLESCRIPT
  ) || status=$?

  ((status == 0)) || {
    report_applescript_error "Could not track the connection state:" "${out}"
    return 1
  }
  printf '%s' "${out}"
}

wait_for_import() {
  local out status=0
  out=$(
    osascript - "${1}" "${2}" <<'APPLESCRIPT' 2>&1
on run argv
  set connName to item 1 of argv
  set deadline to (current date) + ((item 2 of argv) as integer)
  repeat
    try
      tell application "Viscosity"
        if (count of (every connection whose name is connName)) > 0 then return "Imported"
      end tell
    end try
    if (current date) > deadline then return "Timeout"
    delay 1
  end repeat
end run
APPLESCRIPT
  ) || status=$?

  ((status == 0)) || {
    report_applescript_error "Could not confirm the import:" "${out}"
    return 1
  }
  printf '%s' "${out}"
}

# --- 1Password ---------------------------------------------------------------------------

OP_ARGS=()

set_op_args() {
  OP_ARGS=(item get "${PROFILE_OP_ITEM}")
  [[ -z "${PROFILE_OP_VAULT}" ]] || OP_ARGS+=(--vault "${PROFILE_OP_VAULT}")
  [[ -z "${PROFILE_OP_ACCOUNT}" ]] || OP_ARGS+=(--account "${PROFILE_OP_ACCOUNT}")
}

# Prints username and password on two lines. Scoping to a vault keeps op from searching
# every one, which is slower and ambiguous when item titles repeat.
fetch_credentials() {
  set_op_args

  local creds user pass
  creds=$(op "${OP_ARGS[@]}" --fields label=username,label=password --format json --reveal)
  user=$(printf '%s' "${creds}" | jq -r '[.[] | select(.label=="username") | .value] | @tsv')
  pass=$(printf '%s' "${creds}" | jq -r '[.[] | select(.label=="password") | .value] | @tsv')

  # @tsv collapses each match set to one line, so a duplicated label arrives as an embedded
  # tab rather than silently picking whichever value jq emitted first.
  [[ -n "${user}" ]] || die "1Password item '${PROFILE_OP_ITEM}' has no 'username' field"
  [[ -n "${pass}" ]] || die "1Password item '${PROFILE_OP_ITEM}' has no 'password' field"
  [[ "${user}" != *$'\t'* ]] || die "1Password item '${PROFILE_OP_ITEM}' has multiple 'username' fields"
  [[ "${pass}" != *$'\t'* ]] || die "1Password item '${PROFILE_OP_ITEM}' has multiple 'password' fields"

  printf '%s\n%s\n' "${user}" "${pass}"
}

fetch_otp() {
  set_op_args

  local otp
  otp=$(op "${OP_ARGS[@]}" --otp)
  [[ -n "${otp}" ]] || die "1Password item '${PROFILE_OP_ITEM}' has no one-time password"
  printf '%s' "${otp}"
}

# --- credential dialog -------------------------------------------------------------------

# The password field's AXRole is AXTextField, same as the username field: only AXSubrole
# tells them apart, and the username field has no AXSubrole at all. `role description` works
# too but is localized. `text fields of window` returns the password field first, so fields
# are sorted by vertical position to recover username, password, then the challenge field
# when the profile uses static-challenge.
#
# Credentials go through the environment rather than argv to keep them out of ps output. A
# same-user process can still read them, so this narrows exposure rather than removing it.
fill_credentials() {
  local -r user="${1}"
  local -r pass="${2}"
  local -r challenge="${3:-}"

  local out status=0
  out=$(
    VPN_CRED_USER="${user}" VPN_CRED_PASS="${pass}" VPN_CRED_CHALLENGE="${challenge}" \
      osascript <<'APPLESCRIPT' 2>&1
on run
  set theValues to {system attribute "VPN_CRED_USER", system attribute "VPN_CRED_PASS"}
  set theChallenge to system attribute "VPN_CRED_CHALLENGE"
  if theChallenge is not "" then set end of theValues to theChallenge

  tell application "System Events"
    tell process "Viscosity"
      set frontmost to true

      repeat 30 times
        if (count of windows) > 0 then exit repeat
        delay 0.5
      end repeat
      if (count of windows) is 0 then error "Credential dialog did not appear"

      -- Pick the window holding a secure text field, so an open Preferences window is
      -- not mistaken for the credential prompt.
      set theWindow to missing value
      repeat with w in windows
        repeat with tf in text fields of w
          if my isSecure(tf) then
            set theWindow to w
            exit repeat
          end if
        end repeat
        if theWindow is not missing value then exit repeat
      end repeat
      if theWindow is missing value then error "Could not find the credential dialog window"

      set theFields to text fields of theWindow
      if (count of theFields) < (count of theValues) then
        error "Dialog has " & (count of theFields) & " field(s), expected at least " & (count of theValues)
      end if

      set sorted to {}
      repeat with tf in theFields
        set y to my fieldY(tf)
        set insertAt to (count of sorted) + 1
        repeat with j from 1 to (count of sorted)
          if y < (my fieldY(item j of sorted)) then
            set insertAt to j
            exit repeat
          end if
        end repeat
        if insertAt is 1 then
          set sorted to {contents of tf} & sorted
        else if insertAt > (count of sorted) then
          set end of sorted to contents of tf
        else
          set sorted to (items 1 thru (insertAt - 1) of sorted) & ¬
            {contents of tf} & (items insertAt thru -1 of sorted)
        end if
      end repeat

      repeat with i from 1 to (count of theValues)
        set tf to item i of sorted
        set theValue to item i of theValues
        set focused of tf to true
        delay 0.2
        if my isSecure(tf) then
          -- Secure fields reject `set value`, so the text has to be typed.
          keystroke "a" using {command down}
          keystroke theValue
        else
          set value of tf to theValue
        end if
      end repeat

      delay 0.3
      -- The default button rather than one matched by title, which is localized.
      try
        perform action "AXPress" of (value of attribute "AXDefaultButton" of theWindow)
      on error
        key code 36
      end try
    end tell
  end tell
end run

on isSecure(tf)
  try
    tell application "System Events"
      return (value of attribute "AXSubrole" of tf) is "AXSecureTextField"
    end tell
  on error
    return false
  end try
end isSecure

-- The position has to land in a variable before it is indexed: inside a `tell` block
-- `item 2 of (position of ...)` parses as an object specifier and fails with -1700.
on fieldY(tf)
  tell application "System Events"
    set p to position of tf
  end tell
  return item 2 of (p as list)
end fieldY
APPLESCRIPT
  ) || status=$?

  ((status == 0)) || {
    log_error "Could not fill the credential dialog:"
    printf '%s\n' "${out}" >&2
    if [[ "${out}" == *"-1719"* || "${out}" == *"-1743"* || "${out}" == *"assistive"* ]]; then
      log_error "Grant your terminal app Accessibility access in"
      log_error "System Settings > Privacy & Security > Accessibility."
    fi
    return 1
  }
}

# --- AWS Client VPN ----------------------------------------------------------------------

# Every endpoint whatever its status; the jq consumers drop only the ones being torn down.
# pending-associate means no target network is attached, which is a normal resting state:
# the config still exports, so --sync works, and only connecting needs an association.
describe_endpoints() {
  aws ec2 describe-client-vpn-endpoints \
    --profile "${PROFILE_AWS_PROFILE}" \
    --region "${PROFILE_AWS_REGION}" \
    --output json \
    --query 'ClientVpnEndpoints[].{Id:ClientVpnEndpointId,Status:Status.Code,Tags:Tags}'
}

# Expands a name-template against each endpoint's tags, emitting
# "endpoint_id<TAB>connection_name<TAB>status". "{Project}-{Stack}" turns tags Project=acme,
# Stack=dev3 into "acme-dev3". An endpoint missing any referenced tag is skipped.
expand_endpoint_names() {
  printf '%s' "${1}" | jq -r --arg tpl "${2}" '
    .[] | select(.Status != "deleting" and .Status != "deleted") as $e
    | ([$e.Tags[]? | {(.Key): .Value}] | add // {}) as $tags
    | [$tpl | scan("\\{([^{}]+)\\}|([^{}]+)")] as $parts
    | [$parts[] | .[0] | select(. != null)] as $keys
    | if ($keys | length) == 0 or any($keys[]; ($tags[.] // "") == "") then empty
      else "\($e.Id)\t\([$parts[] | if .[0] != null then $tags[.[0]] else .[1] end] | join(""))\t\($e.Status)"
      end
  '
}

# "endpoint_id<TAB>status" for every endpoint in an already-fetched list carrying KEY=VALUE.
endpoints_by_tag() {
  printf '%s' "${1}" | jq -r --arg k "${2%%=*}" --arg v "${2#*=}" '
    .[]
    | select(.Status != "deleting" and .Status != "deleted")
    | select(any(.Tags[]?; .Key == $k and .Value == $v))
    | "\(.Id)\t\(.Status)"
  '
}

# Sets ENDPOINT_MAP to "profile<TAB>endpoint_id<TAB>connection_name<TAB>origin<TAB>status"
# rows for everything syncable, where origin is pinned or template. An optional prefix limits
# which profiles are queried, so `--discover acme` does not wake every account.
#
# Assigns rather than prints: under $( ) the temp dir would be registered in a subshell and
# the parent would leak it.
#
# A pinned profile claims its endpoint, dropping it from template discovery. That is the
# escape hatch when two endpoints expand to the same name.
ENDPOINT_MAP=""
ENDPOINT_MAP_QUERIED=0

build_endpoint_map() {
  local -r filter="${1:-}"

  make_tmpdir
  local -r dir="${TMPDIR_LAST}"

  local -A tpl_of=() conn_of=() tag_of=() eid_of=()
  local -a pids=() queried=()
  local profile

  # All accounts are queried at once: each call costs a second or more, so in sequence this
  # would be half a minute rather than three. Output files are named by array index, which
  # keeps a profile name out of the path.
  while read -r profile; do
    [[ -z "${filter}" || "${profile}" == "${filter}"* ]] || continue
    load_profile "${profile}"
    [[ "${PROFILE_KIND}" == "aws-clientvpn" ]] || continue

    tpl_of["${profile}"]="${PROFILE_NAME_TEMPLATE}"
    conn_of["${profile}"]="${PROFILE_CONNECTION}"
    tag_of["${profile}"]="${PROFILE_ENDPOINT_TAG}"
    eid_of["${profile}"]="${PROFILE_ENDPOINT_ID}"

    describe_endpoints >"${dir}/${#queried[@]}.json" 2>"${dir}/${#queried[@]}.err" &
    pids+=("$!")
    queried+=("${profile}")
  done < <(list_profiles)

  ENDPOINT_MAP_QUERIED="${#queried[@]}"

  local i
  for i in "${!pids[@]}"; do
    wait "${pids[i]}" || {
      log_warn "[${queried[i]}] could not list endpoints:"
      cat "${dir}/${i}.err" >&2
    }
  done

  local rows="" claimed="" raw id name status
  for i in "${!queried[@]}"; do
    profile="${queried[i]}"
    raw=$(<"${dir}/${i}.json")
    [[ -n "${raw}" ]] || continue

    if [[ -n "${tpl_of[${profile}]}" ]]; then
      while IFS=$'\t' read -r id name status; do
        [[ -n "${id}" ]] || continue
        rows+="${profile}"$'\t'"${id}"$'\t'"${name}"$'\t'"template"$'\t'"${status}"$'\n'
      done < <(expand_endpoint_names "${raw}" "${tpl_of[${profile}]}")
    else
      id="${eid_of[${profile}]}"
      status=""
      [[ -n "${id}" ]] ||
        IFS=$'\t' read -r id status < <(endpoints_by_tag "${raw}" "${tag_of[${profile}]}") || true
      [[ -n "${id}" ]] || id="<unresolved>"
      rows+="${profile}"$'\t'"${id}"$'\t'"${conn_of[${profile}]}"$'\t'"pinned"$'\t'"${status}"$'\n'
      claimed+="${id}"$'\n'
    fi
  done

  # The claim list goes through the environment because awk -v cannot carry newlines.
  ENDPOINT_MAP=$(printf '%s' "${rows}" | VPN_CLAIMED="${claimed}" awk -F'\t' '
    BEGIN {
      n = split(ENVIRON["VPN_CLAIMED"], a, "\n")
      for (i = 1; i <= n; i++) if (a[i] != "") owned[a[i]] = 1
    }
    NF == 0 { next }
    $4 == "template" && ($2 in owned) { next }
    { print }
  ')
}

# Sets ENDPOINT_ID, and ENDPOINT_STATUS when it is known. A pinned endpoint-id is taken at
# face value so the common case costs no AWS call.
ENDPOINT_ID=""
ENDPOINT_STATUS=""

resolve_endpoint_id() {
  ENDPOINT_ID="${PROFILE_ENDPOINT_ID}"
  ENDPOINT_STATUS=""
  [[ -z "${ENDPOINT_ID}" ]] || return 0

  local tag_key="${PROFILE_ENDPOINT_TAG%%=*}"
  local tag_value="${PROFILE_ENDPOINT_TAG#*=}"
  [[ -n "${tag_key}" && "${tag_key}" != "${PROFILE_ENDPOINT_TAG}" ]] ||
    die "[${PROFILE_NAME}] endpoint-tag must be KEY=VALUE, got: '${PROFILE_ENDPOINT_TAG}'"

  log_info "Resolving endpoint by tag ${tag_key}=${tag_value} in ${PROFILE_AWS_REGION}..."
  local raw
  raw=$(describe_endpoints)

  local -a matches=()
  local line
  while IFS= read -r line; do
    [[ -n "${line}" ]] && matches+=("${line}")
  done < <(endpoints_by_tag "${raw}" "${PROFILE_ENDPOINT_TAG}")

  case "${#matches[@]}" in
  0) die "No Client VPN endpoint tagged ${tag_key}=${tag_value} in ${PROFILE_AWS_REGION}" ;;
  1) IFS=$'\t' read -r ENDPOINT_ID ENDPOINT_STATUS <<<"${matches[0]}" ;;
  *) die "Tag ${tag_key}=${tag_value} matches ${#matches[@]} endpoints: ${matches[*]%%$'\t'*}. Use endpoint-id instead." ;;
  esac
}

# Route 53 private zones attached to an endpoint's VPC, one per line, trailing dot stripped.
#
# AWS can push DNS servers but has no way to push a search domain. Without one Viscosity
# scopes the VPN resolver to a placeholder domain ("utun10.viscosity") and macOS never sends
# it a real query, so private-zone names stay unresolvable while the tunnel is up.
#
# Zones owned by a service (EKS, EFS) are internal plumbing and only add noise.
endpoint_search_domains() {
  local vpc names
  vpc=$(aws ec2 describe-client-vpn-endpoints \
    --profile "${PROFILE_AWS_PROFILE}" \
    --region "${PROFILE_AWS_REGION}" \
    --client-vpn-endpoint-ids "${1}" \
    --output text \
    --query 'ClientVpnEndpoints[0].VpcId')
  [[ -n "${vpc}" && "${vpc}" != "None" ]] || return 0

  names=$(aws route53 list-hosted-zones-by-vpc \
    --profile "${PROFILE_AWS_PROFILE}" \
    --region us-east-1 \
    --vpc-id "${vpc}" \
    --vpc-region "${PROFILE_AWS_REGION}" \
    --output text \
    --query 'HostedZoneSummaries[?!not_null(Owner.OwningService)].Name')
  [[ -n "${names}" && "${names}" != "None" ]] || return 0

  printf '%s\n' "${names}" | tr '\t' '\n' | sed 's/\.$//'
}

# A bundle rather than the raw .ovpn because Viscosity names an imported .ovpn after the
# endpoint's region ("AWS Client VPN - eu-west-1"), which collides as soon as two endpoints
# share a region. A bundle's config.conf carries `#viscosity name`, so the name is ours.
build_visc_bundle() {
  local -r raw="${1}"
  local -r bundle="${2}"
  local -r domains="${3:-}"

  mkdir -p "${bundle}"

  grep -q '^<ca>' "${raw}" || die "Exported configuration has no inline <ca> block"
  awk '/^<ca>/ { inside = 1; next } /^<\/ca>/ { inside = 0; next } inside' "${raw}" >"${bundle}/ca.crt"
  [[ -s "${bundle}/ca.crt" ]] || die "Exported configuration has an empty <ca> block"

  {
    printf '#-- Generated by vpn-connect from AWS Client VPN --#\n'
    printf '#viscosity name %s\n' "${PROFILE_CONNECTION}"
    printf '#viscosity protocol openvpn\n'
    if grep -q '^auth-federate' "${raw}"; then
      # Viscosity's own name for the AWS SAML browser flow, and what it writes when it
      # imports an auth-federate config itself.
      printf '#viscosity web-authentication-custom aws\n'
    fi
    local domain
    while read -r domain; do
      [[ -z "${domain}" ]] || printf 'dhcp-option DOMAIN-SEARCH %s\n' "${domain}"
    done <<<"${domains}"
    awk '
      /^<ca>/      { inside = 1; print "ca ca.crt"; next }
      /^<\/ca>/    { inside = 0; next }
      inside       { next }
      /^auth-federate[[:space:]]*$/ { next }
      { print }
    ' "${raw}"
  } >"${bundle}/config.conf"
}

sync_profile() {
  local endpoint_id="${1:-}"
  local endpoint_status="${2:-}"

  [[ "${PROFILE_KIND}" == "aws-clientvpn" ]] ||
    die "[${PROFILE_NAME}] --sync only applies to kind = aws-clientvpn"

  [[ -n "${PROFILE_CONNECTION}" ]] ||
    die "[${PROFILE_NAME}] uses name-template and covers several endpoints; name one of them, or run: ${0##*/} --discover ${PROFILE_NAME}"

  require_command aws
  require_viscosity
  load_snapshot || return 1

  if [[ "$(connection_state "${PROFILE_CONNECTION}")" != "Missing" ]]; then
    log_error "Viscosity already has a connection named '${PROFILE_CONNECTION}'."
    log_error "Re-importing would create a duplicate rather than replace it."
    log_error "Delete it first in Viscosity > Preferences > Connections, then re-run --sync."
    return 1
  fi

  if [[ -z "${endpoint_id}" ]]; then
    resolve_endpoint_id
    endpoint_id="${ENDPOINT_ID}"
    endpoint_status="${ENDPOINT_STATUS}"
  fi

  # A SAML bundle holds no secrets but a mutual-auth export would, so it is removed on exit.
  make_tmpdir
  local -r work="${TMPDIR_LAST}"

  log_info "Exporting configuration for ${endpoint_id}..."
  (
    umask 077
    aws ec2 export-client-vpn-client-configuration \
      --profile "${PROFILE_AWS_PROFILE}" \
      --region "${PROFILE_AWS_REGION}" \
      --output text \
      --client-vpn-endpoint-id "${endpoint_id}"
  ) >"${work}/raw.ovpn"
  [[ -s "${work}/raw.ovpn" ]] || die "AWS returned an empty configuration for ${endpoint_id}"

  # Non-fatal: a connection without search domains still works, it just cannot resolve the
  # VPC's private zones.
  local domains=""
  domains=$(endpoint_search_domains "${endpoint_id}") ||
    log_warn "Could not list Route 53 zones for the endpoint's VPC; importing without a DNS search domain."
  if [[ -n "${domains}" ]]; then
    log_info "DNS search domains: ${domains//$'\n'/ }"
  else
    log_warn "The VPC has no private hosted zone, so no DNS search domain is set."
  fi

  local bundle="${work}/${PROFILE_CONNECTION}.visc"
  (
    umask 077
    build_visc_bundle "${work}/raw.ovpn" "${bundle}" "${domains}"
  )

  log_info "Importing '${PROFILE_CONNECTION}' into Viscosity..."
  log_info "Viscosity shows a 'Connection Imported' notice afterwards. It is informational."
  open -a Viscosity "${bundle}"

  # Viscosity registers the connection before the notice is dismissed, so this waits only
  # for the import, which must finish before cleanup removes the source bundle.
  local imported
  imported=$(wait_for_import "${PROFILE_CONNECTION}" "${IMPORT_TIMEOUT}")
  [[ "${imported}" == "Imported" ]] ||
    die "Viscosity did not register '${PROFILE_CONNECTION}' within ${IMPORT_TIMEOUT}s."

  # The connection name, not the profile name: a template profile covers many endpoints
  # and is not itself something you connect to.
  log_info "Imported '${PROFILE_CONNECTION}'. Connect with: ${0##*/} ${PROFILE_CONNECTION}"

  [[ "${endpoint_status}" != "pending-associate" ]] ||
    log_warn "${endpoint_id} has no target network associated, so connecting fails until one is."
}

# --- target resolution -------------------------------------------------------------------

# Reads a connection's stored config to work out how it authenticates, so that
# `vpn <discovered-name>` works without a profile section or an AWS round-trip.
viscosity_connection_auth() {
  local -r conn="${1}"
  local dir config name
  for dir in "${HOME}/Library/Application Support/Viscosity/OpenVPN/"*/; do
    config="${dir}config.conf"
    [[ -r "${config}" ]] || continue
    name=$(awk '/^#viscosity name /{ sub(/^#viscosity name /, ""); gsub(/^"|"$/, ""); print; exit }' "${config}")
    [[ "${name}" == "${conn}" ]] || continue
    if grep -q '^#viscosity web-authentication' "${config}"; then
      printf 'web'
    else
      printf 'none'
    fi
    return 0
  done
  printf 'none'
}

# Accepts a profile section name or the name of a connection Viscosity already has. The
# latter is what makes `vpn acme-dev3` work for a template-discovered endpoint with no
# section of its own.
resolve_target() {
  local -r target="${1:-}"

  if [[ -z "${target}" ]] || is_profile "${target}"; then
    load_profile "${target}"
    return 0
  fi

  require_viscosity
  load_snapshot || return 1
  if [[ "$(connection_state "${target}")" == "Missing" ]]; then
    log_error "No profile or Viscosity connection named '${target}'."
    log_error "Run '${0##*/} --list' for the profiles, or '${0##*/} --status' for the connections."
    log_error "If it is an AWS endpoint, import it first: ${0##*/} --sync ${target}"
    return 1
  fi

  PROFILE_NAME="${target}"
  PROFILE_KIND="viscosity"
  PROFILE_CONNECTION="${target}"
  PROFILE_AUTH=$(viscosity_connection_auth "${target}")
  PROFILE_OTP_MODE="none"
  if [[ "${PROFILE_AUTH}" == "web" ]]; then
    PROFILE_TIMEOUT="${WEB_AUTH_TIMEOUT}"
  else
    PROFILE_TIMEOUT="${DEFAULT_TIMEOUT}"
  fi
}

# Accepts a profile section name, or a connection name a profile's name-template produces.
resolve_sync_target() {
  local -r target="${1}"

  if is_profile "${target}"; then
    load_profile "${target}"
    sync_profile
    return
  fi

  require_command aws
  require_command jq
  log_info "Looking up '${target}' across AWS Client VPN profiles..."

  build_endpoint_map
  local -r map="${ENDPOINT_MAP}"

  local -a hits=()
  local line
  while IFS= read -r line; do
    [[ -n "${line}" ]] && hits+=("${line}")
  done < <(printf '%s\n' "${map}" | awk -F'\t' -v n="${target}" '$3 == n')

  case "${#hits[@]}" in
  0)
    log_error "No profile or discoverable endpoint named '${target}'."
    log_error "Available:"
    printf '%s\n' "${map}" | awk -F'\t' 'NF { printf "    %-34s (%s, %s)\n", $3, $1, $4 }' >&2
    return 1
    ;;
  1) : ;;
  *)
    log_error "'${target}' matches ${#hits[@]} endpoints:"
    printf '%s\n' "${hits[@]}" | awk -F'\t' '{ printf "    %s  (profile %s)\n", $2, $1 }' >&2
    log_error "Use a more specific name-template, or pin one of them to its own profile"
    log_error "section with endpoint-id plus connection, which drops it from discovery and"
    log_error "makes the other name unambiguous."
    return 1
    ;;
  esac

  # _ absorbs the origin column; declared local so read does not write the global.
  local hit_profile hit_id hit_name hit_status _
  IFS=$'\t' read -r hit_profile hit_id hit_name _ hit_status <<<"${hits[0]}"

  load_profile "${hit_profile}"
  PROFILE_CONNECTION="${hit_name}"
  sync_profile "${hit_id}" "${hit_status}"
}

# --- actions -----------------------------------------------------------------------------

discover() {
  local -r filter="${1:-}"

  require_command aws
  require_command jq
  require_viscosity
  load_snapshot || return 1

  build_endpoint_map "${filter}"
  local -r map="${ENDPOINT_MAP}"
  [[ -n "${map}" ]] || {
    if ((ENDPOINT_MAP_QUERIED > 0)); then
      # Distinguishes an empty account from a failed query: an expired AWS session fails
      # every profile at once, and pointing at the config file would be misleading.
      log_warn "None of the ${ENDPOINT_MAP_QUERIED} queried profile(s) returned an endpoint."
      log_warn "If there are errors above, refresh your AWS session and retry."
    elif [[ -n "${filter}" ]]; then
      log_warn "No aws-clientvpn profile starts with '${filter}'. Run '${0##*/} --list' to see them."
    else
      log_warn "No aws-clientvpn profiles defined in ${CONFIG_FILE}"
    fi
    return 0
  }

  printf '%-30s %-20s %-9s %-18s %s\n' "CONNECTION" "PROFILE" "ORIGIN" "STATUS" "IMPORTED"
  local profile id name origin status state
  while IFS=$'\t' read -r profile id name origin status; do
    [[ -n "${name}" ]] || continue
    state=$(connection_state "${name}")
    printf '%-30s %-20s %-9s %-18s %s\n' "${name}" "${profile}" "${origin}" "${status:--}" \
      "$([[ "${state}" == "Missing" ]] && printf 'no' || printf 'yes')"
  done <<<"${map}"
}

connect_profile() {
  require_viscosity
  load_snapshot || return 1

  local state
  state=$(connection_state "${PROFILE_CONNECTION}")

  case "${state}" in
  Connected)
    log_info "Already connected to '${PROFILE_CONNECTION}'."
    return 0
    ;;
  Missing)
    [[ "${PROFILE_KIND}" != "aws-clientvpn" ]] ||
      die "Viscosity has no connection named '${PROFILE_CONNECTION}'. Import it with: ${0##*/} --sync ${PROFILE_NAME}"
    die "Viscosity has no connection named '${PROFILE_CONNECTION}'."
    ;;
  *) : ;;
  esac

  local user="" pass="" otp="" creds=""
  if [[ "${PROFILE_AUTH}" == "op-dialog" ]]; then
    require_command op
    require_command jq

    log_info "Fetching credentials from 1Password..."
    creds=$(fetch_credentials)
    {
      read -r user
      read -r pass
    } <<<"${creds}"
    creds=""
  fi

  log_info "Connecting to '${PROFILE_CONNECTION}'..."
  viscosity_command connect "${PROFILE_CONNECTION}"

  if [[ "${PROFILE_AUTH}" == "op-dialog" ]]; then
    if [[ "${PROFILE_OTP_MODE}" != "none" ]]; then
      # Fetched after the connection is triggered: TOTP codes rotate every 30s, so an
      # earlier fetch risks expiring while the dialog is still appearing.
      log_info "Fetching one-time password from 1Password..."
      otp=$(fetch_otp)
    fi

    log_info "Filling credentials..."
    case "${PROFILE_OTP_MODE}" in
    append) fill_credentials "${user}" "${pass}${otp}" ;;
    challenge) fill_credentials "${user}" "${pass}" "${otp}" ;;
    none) fill_credentials "${user}" "${pass}" ;;
    *) die "[${PROFILE_NAME}] unknown otp-mode: '${PROFILE_OTP_MODE}'" ;;
    esac
    user="" pass="" otp=""
  elif [[ "${PROFILE_AUTH}" == "web" ]]; then
    # A cached SAML session connects straight through; otherwise Viscosity asks to open
    # the browser and waits for the sign-in, which is why the timeout is minutes not seconds.
    log_info "Viscosity handles authentication itself. Watch for a browser prompt."
  fi

  log_info "Waiting for connection (up to ${PROFILE_TIMEOUT}s)..."
  local result
  result=$(wait_for_connected "${PROFILE_CONNECTION}" "${PROFILE_TIMEOUT}")

  case "${result}" in
  Connected) log_info "Connected to '${PROFILE_CONNECTION}'." ;;
  Failed) die "'${PROFILE_CONNECTION}' returned to Disconnected. Check Viscosity's log for the reason." ;;
  *) die "Timed out after ${PROFILE_TIMEOUT}s. Check Viscosity's log, or raise 'timeout' for this profile." ;;
  esac
}

down_profile() {
  [[ -n "${PROFILE_CONNECTION}" ]] ||
    die "[${PROFILE_NAME}] uses name-template and covers several connections; name one of them, or use --down --all"

  require_viscosity
  load_snapshot || return 1

  local state
  state=$(connection_state "${PROFILE_CONNECTION}")
  case "${state}" in
  Missing) die "Viscosity has no connection named '${PROFILE_CONNECTION}'." ;;
  Disconnected) log_info "'${PROFILE_CONNECTION}' is already disconnected." ;;
  *)
    viscosity_command disconnect "${PROFILE_CONNECTION}"
    log_info "Disconnected '${PROFILE_CONNECTION}'."
    ;;
  esac
}

down_all() {
  require_viscosity
  viscosity_command disconnectall
  log_info "All VPN connections disconnected."
}

# Lists what Viscosity actually has rather than iterating profiles, because a profile using
# name-template stands for many connections and knowing which would cost an AWS call.
status() {
  local -r only="${1:-}"
  require_viscosity
  load_snapshot || return 1

  if [[ -n "${only}" ]]; then
    local conn="${only}" owner="-"
    if is_profile "${only}"; then
      load_profile "${only}"
      [[ -n "${PROFILE_CONNECTION}" ]] ||
        die "[${only}] uses name-template and covers several connections; run --discover, or name one of them"
      conn="${PROFILE_CONNECTION}"
      owner="${only}"
    fi
    local state detail time
    state=$(connection_state "${conn}")
    detail="${state}"
    if [[ "${state}" == "Connected" ]]; then
      time=$(connection_time "${conn}")
      [[ -z "${time}" ]] || detail="Connected (${time})"
    fi
    printf '%-32s %-24s %s\n' "${conn}" "${owner}" "${detail}"
    return 0
  fi

  # Built once: looking the owner up per connection meant an awk process per row.
  local -A owner_of=()
  local conn prof
  while IFS=$'\t' read -r conn prof; do
    [[ -z "${conn}" ]] || owner_of["${conn}"]="${prof}"
  done < <(profile_connections)

  printf '%-32s %-24s %s\n' "CONNECTION" "PROFILE" "STATE"
  local name state time detail
  while IFS=$'\t' read -r name state time; do
    [[ -n "${name}" ]] || continue
    detail="${state}"
    [[ "${state}" == "Connected" && -n "${time}" ]] && detail="Connected (${time})"
    printf '%-32s %-24s %s\n' "${name}" "${owner_of[${name}]:--}" "${detail}"
  done <<<"${SNAPSHOT}"
}

# Candidates for `vpn <Tab>`: profile names plus the connections Viscosity already has.
# AWS endpoints that have not been synced yet are deliberately left out, since listing
# them would mean an AWS call on every keystroke. Use --discover for those.
complete_targets() {
  list_profiles
  pgrep -x Viscosity >/dev/null 2>&1 || return 0
  load_snapshot 2>/dev/null || return 0
  printf '%s\n' "${SNAPSHOT}" | cut -f1
}

# --- main --------------------------------------------------------------------------------

main() {
  local target="${usage_target:-}"
  local action="connect"

  if [[ "${usage_complete_targets:-}" == "true" ]]; then
    require_config
    complete_targets
    return 0
  fi

  [[ "${usage_status:-}" != "true" ]] || action="status"
  [[ "${usage_down:-}" != "true" ]] || action="down"
  [[ "${usage_sync:-}" != "true" ]] || action="sync"
  [[ "${usage_discover:-}" != "true" ]] || action="discover"
  [[ "${usage_list:-}" != "true" ]] || action="list"

  require_macos
  require_config

  trap cleanup EXIT
  # Exit rather than resume, so Ctrl+C during a wait stops the script instead of letting
  # the loop carry on.
  trap 'log_warn "Interrupted."; exit 130' INT TERM

  case "${action}" in
  list) list_profiles ;;
  status) status "${target}" ;;
  discover) discover "${target}" ;;
  down)
    if [[ "${usage_all:-}" == "true" ]]; then
      [[ -z "${target}" ]] || die "--down --all takes no target"
      down_all
    else
      resolve_target "${target}"
      down_profile
    fi
    ;;
  sync)
    [[ -n "${target}" ]] || die "--sync requires a profile or connection name"
    resolve_sync_target "${target}"
    ;;
  connect)
    resolve_target "${target}"
    connect_profile
    ;;
  *) die "Internal error: unhandled action '${action}'" ;;
  esac
}

main
