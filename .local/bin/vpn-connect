#!/usr/bin/env bash
# Control Viscosity VPN connections from the command line.
#
# Supports two kinds of connection, selected per profile:
#
#   kind = viscosity      A connection already present in Viscosity. Credentials and a live
#                         TOTP are pulled from 1Password and typed into Viscosity's credential
#                         dialog via macOS Accessibility.
#   kind = aws-clientvpn  An AWS Client VPN endpoint. `--sync` downloads the endpoint's
#                         configuration from AWS and imports it into Viscosity as a named
#                         connection. Authentication is handled by Viscosity itself (SAML web
#                         auth, or a client certificate), so no credential typing is involved.
#
# All environment-specific values live in a profiles file outside this repository:
#   ${XDG_CONFIG_HOME:-$HOME/.config}/vpn-connect/profiles.conf
# See profiles.conf.example for the format. Nothing company-specific belongs in this script.
#
# One-time setup for `auth = op-dialog` profiles: grant Accessibility access to your terminal
# app in System Settings -> Privacy & Security -> Accessibility.
#
# Requires:
#   - Viscosity                      (running)
#   - 1Password CLI (brew install 1password-cli)   for auth = op-dialog
#   - jq            (brew install jq)              for auth = op-dialog
#   - AWS CLI v2    (brew install awscli)          for kind = aws-clientvpn
#
# An aws-clientvpn profile can cover many endpoints at once: set name-template to build each
# connection name from the endpoint's tags, e.g. "{Project}-{Stack}" names an endpoint tagged
# Project=acme, Stack=dev3 as "acme-dev3". That name is then usable directly as a target.
#
# Examples:
#   vpn                     Connect using the first profile in the profiles file
#   vpn work-full           Connect using the named profile
#   vpn acme-dev3           Connect using a template-derived connection name
#   vpn --status            Show the state of every Viscosity connection
#   vpn --down work-full    Disconnect one profile
#   vpn --down --all        Disconnect every Viscosity connection
#   vpn --discover          List AWS endpoints and the names they would import as
#   vpn --sync acme-dev3    Download that endpoint's config and import it into Viscosity
#   vpn --list              List configured profiles

set -o errexit
set -o pipefail
set -o nounset

readonly DEFAULT_TIMEOUT=30
# Browser-based SAML sign-in waits on a person, so it needs far longer than a password login.
readonly WEB_AUTH_TIMEOUT=180
# Viscosity imports a bundle asynchronously after `open` hands it over.
readonly IMPORT_TIMEOUT=30
CONFIG_FILE="${VPN_CONNECT_CONFIG:-${XDG_CONFIG_HOME:-${HOME}/.config}/vpn-connect/profiles.conf}"
readonly CONFIG_FILE

# Populated by load_profile().
PROFILE_NAME=""
PROFILE_KIND=""
PROFILE_CONNECTION=""
PROFILE_AUTH=""
PROFILE_OP_ITEM=""
PROFILE_OP_VAULT=""
PROFILE_OP_ACCOUNT=""
PROFILE_OTP_MODE=""
PROFILE_AWS_PROFILE=""
PROFILE_AWS_REGION=""
PROFILE_ENDPOINT_ID=""
PROFILE_ENDPOINT_TAG=""
PROFILE_NAME_TEMPLATE=""
PROFILE_TIMEOUT=""

# Colors are only emitted to a terminal, and never when NO_COLOR is set, so that redirected
# or piped output stays clean.
if [[ -t 2 && -z "${NO_COLOR:-}" ]]; then
  readonly C_GREEN=$'\033[0;32m'
  readonly C_RED=$'\033[0;31m'
  readonly C_YELLOW=$'\033[1;33m'
  readonly C_RESET=$'\033[0m'
else
  readonly C_GREEN="" C_RED="" C_YELLOW="" C_RESET=""
fi

log_info() { printf '%s[INFO]%s %s\n' "${C_GREEN}" "${C_RESET}" "${1}" >&2; }
log_warn() { printf '%s[WARN]%s %s\n' "${C_YELLOW}" "${C_RESET}" "${1}" >&2; }
log_error() { printf '%s[ERROR]%s %s\n' "${C_RED}" "${C_RESET}" "${1}" >&2; }

die() {
  log_error "${1}"
  exit "${2:-1}"
}

usage() {
  cat <<EOF
Usage: ${0##*/} [TARGET]
       ${0##*/} --status [PROFILE]
       ${0##*/} --down [PROFILE | --all]
       ${0##*/} --sync TARGET
       ${0##*/} --discover
       ${0##*/} --list

TARGET is either a profile name from the profiles file, or a connection name derived
from an aws-clientvpn profile's name-template (see --discover).

Actions:
    (none)          Connect using TARGET, or the first profile if omitted
    -s, --status    Show connection state; all profiles when PROFILE is omitted
    -d, --down      Disconnect PROFILE, or every connection with --all
        --sync      Download an AWS Client VPN config and import it into Viscosity
        --discover  List AWS Client VPN endpoints and the names they would import as
    -l, --list      List the configured profiles
    -h, --help      Show this help message

Profiles are read from:
    ${CONFIG_FILE}

Override the location with the VPN_CONNECT_CONFIG environment variable.
EOF
}

require_command() {
  command -v "${1}" >/dev/null 2>&1 ||
    die "${1} not found. Install with: ${2}"
}

require_viscosity() {
  pgrep -x Viscosity >/dev/null 2>&1 ||
    die "Viscosity is not running. Please launch Viscosity first."
}

# --- profiles file -----------------------------------------------------------------------

# Emits "key<TAB>value" for one section, or every "section<TAB>key<TAB>value" when no section
# is given. Values are read literally: the file is never sourced or eval'd, so a malformed
# line cannot execute anything.
parse_config() {
  local -r want="${1:-}"
  awk -v want="${want}" '
    /^[[:space:]]*[#;]/ { next }
    /^[[:space:]]*$/    { next }
    /^[[:space:]]*\[/ {
      section = $0
      sub(/^[[:space:]]*\[[[:space:]]*/, "", section)
      sub(/[[:space:]]*\].*$/, "", section)
      next
    }
    {
      line = $0
      sub(/[[:space:]]*[#;].*$/, "", line)          # strip trailing comment
      if (index(line, "=") == 0) next
      key = substr(line, 1, index(line, "=") - 1)
      val = substr(line, index(line, "=") + 1)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)
      if (key == "") next
      if (want == "") { print section "\t" key "\t" val }
      else if (section == want) { print key "\t" val }
    }
  ' "${CONFIG_FILE}"
}

list_profiles() {
  awk '
    /^[[:space:]]*\[/ {
      s = $0
      sub(/^[[:space:]]*\[[[:space:]]*/, "", s)
      sub(/[[:space:]]*\].*$/, "", s)
      if (s != "") print s
    }
  ' "${CONFIG_FILE}"
}

require_config() {
  [[ -r "${CONFIG_FILE}" ]] ||
    die "Profiles file not found: ${CONFIG_FILE}
Copy profiles.conf.example there and fill in your own values."
}

load_profile() {
  local name="${1:-}"

  if [[ -z "${name}" ]]; then
    name=$(list_profiles | head -n 1)
    [[ -n "${name}" ]] || die "No profiles defined in ${CONFIG_FILE}"
  fi

  list_profiles | grep -qxF "${name}" ||
    die "Unknown profile: '${name}'. Known profiles: $(list_profiles | paste -sd' ' -)"

  PROFILE_NAME="${name}"
  PROFILE_KIND="viscosity"
  PROFILE_CONNECTION=""
  PROFILE_AUTH=""
  PROFILE_OP_ITEM=""
  PROFILE_OP_VAULT=""
  PROFILE_OP_ACCOUNT=""
  PROFILE_OTP_MODE="append"
  PROFILE_AWS_PROFILE=""
  PROFILE_AWS_REGION=""
  PROFILE_ENDPOINT_ID=""
  PROFILE_ENDPOINT_TAG=""
  PROFILE_NAME_TEMPLATE=""
  PROFILE_TIMEOUT="${DEFAULT_TIMEOUT}"

  local key value
  while IFS=$'\t' read -r key value; do
    case "${key}" in
    kind) PROFILE_KIND="${value}" ;;
    connection) PROFILE_CONNECTION="${value}" ;;
    auth) PROFILE_AUTH="${value}" ;;
    op-item) PROFILE_OP_ITEM="${value}" ;;
    op-vault) PROFILE_OP_VAULT="${value}" ;;
    op-account) PROFILE_OP_ACCOUNT="${value}" ;;
    otp-mode) PROFILE_OTP_MODE="${value}" ;;
    aws-profile) PROFILE_AWS_PROFILE="${value}" ;;
    aws-region) PROFILE_AWS_REGION="${value}" ;;
    endpoint-id) PROFILE_ENDPOINT_ID="${value}" ;;
    endpoint-tag) PROFILE_ENDPOINT_TAG="${value}" ;;
    name-template) PROFILE_NAME_TEMPLATE="${value}" ;;
    timeout) PROFILE_TIMEOUT="${value}" ;;
    *) log_warn "[${name}] ignoring unknown key: ${key}" ;;
    esac
  done < <(parse_config "${name}")

  case "${PROFILE_KIND}" in
  viscosity)
    [[ -n "${PROFILE_CONNECTION}" ]] || die "[${name}] missing required key: connection"
    ;;
  aws-clientvpn)
    [[ -n "${PROFILE_AWS_PROFILE}" ]] || die "[${name}] aws-clientvpn requires: aws-profile"
    [[ -n "${PROFILE_AWS_REGION}" ]] || die "[${name}] aws-clientvpn requires: aws-region"
    # A profile either pins one endpoint (connection + endpoint-id/endpoint-tag) or discovers
    # many, naming each from its tags via name-template.
    if [[ -n "${PROFILE_NAME_TEMPLATE}" ]]; then
      [[ -z "${PROFILE_ENDPOINT_ID}${PROFILE_ENDPOINT_TAG}" ]] ||
        die "[${name}] name-template discovers endpoints, so it cannot be combined with endpoint-id or endpoint-tag"
    else
      [[ -n "${PROFILE_CONNECTION}" ]] ||
        die "[${name}] aws-clientvpn requires either name-template, or connection plus endpoint-id/endpoint-tag"
      [[ -n "${PROFILE_ENDPOINT_ID}${PROFILE_ENDPOINT_TAG}" ]] ||
        die "[${name}] aws-clientvpn requires one of: endpoint-id, endpoint-tag, name-template"
    fi
    [[ -z "${PROFILE_AUTH}" ]] && PROFILE_AUTH="web"
    ;;
  *) die "[${name}] unknown kind: '${PROFILE_KIND}' (expected viscosity or aws-clientvpn)" ;;
  esac

  [[ -z "${PROFILE_AUTH}" ]] && PROFILE_AUTH="op-dialog"

  case "${PROFILE_AUTH}" in
  op-dialog)
    [[ -n "${PROFILE_OP_ITEM}" ]] ||
      die "[${name}] auth = op-dialog requires: op-item"
    ;;
  web | none) : ;;
  *) die "[${name}] unknown auth: '${PROFILE_AUTH}' (expected op-dialog, web or none)" ;;
  esac

  [[ "${PROFILE_TIMEOUT}" =~ ^[0-9]+$ ]] ||
    die "[${name}] timeout must be a whole number of seconds, got: '${PROFILE_TIMEOUT}'"
}

# --- Viscosity ---------------------------------------------------------------------------

# Emits "name<TAB>state<TAB>timeConnected" for every connection.
#
# Viscosity does not support `connection "NAME"` by name (it raises -10002), so this fetches
# the three property lists in three Apple Events and joins them in AppleScript rather than
# walking `connections` and paying an Apple Event per property.
viscosity_snapshot() {
  local out status=0
  out=$(
    osascript <<'APPLESCRIPT' 2>&1
tell application "Viscosity"
  set theNames to name of every connection
  set theStates to state of every connection
  set theTimes to timeConnected of every connection
end tell
set rows to {}
repeat with i from 1 to (count of theNames)
  set end of rows to ((item i of theNames) & tab & (item i of theStates) & tab & (item i of theTimes))
end repeat
set AppleScript's text item delimiters to linefeed
return rows as text
APPLESCRIPT
  ) || status=$?

  if ((status != 0)); then
    log_error "Could not query Viscosity via AppleScript:"
    printf '%s\n' "${out}" >&2
    if [[ "${out}" == *"-1743"* || "${out}" == *"not allowed"* ]]; then
      log_error "Grant your terminal app Automation access to Viscosity in"
      log_error "System Settings -> Privacy & Security -> Automation."
    fi
    return 1
  fi

  printf '%s\n' "${out}"
}

# Prints the state of one connection, or "Missing" when Viscosity does not know the name.
connection_state() {
  local -r conn="${1}"
  local -r snapshot="${2}"
  local name state rest
  while IFS=$'\t' read -r name state rest; do
    if [[ "${name}" == "${conn}" ]]; then
      printf '%s' "${state}"
      return 0
    fi
  done <<<"${snapshot}"
  printf 'Missing'
}

connection_time() {
  local -r conn="${1}"
  local -r snapshot="${2}"
  local name state time
  while IFS=$'\t' read -r name state time; do
    if [[ "${name}" == "${conn}" ]]; then
      printf '%s' "${time}"
      return 0
    fi
  done <<<"${snapshot}"
}

viscosity_connect() {
  osascript - "${1}" <<'APPLESCRIPT' >/dev/null
on run argv
  tell application "Viscosity" to connect (item 1 of argv)
end run
APPLESCRIPT
}

viscosity_disconnect() {
  osascript - "${1}" <<'APPLESCRIPT' >/dev/null
on run argv
  tell application "Viscosity" to disconnect (item 1 of argv)
end run
APPLESCRIPT
}

# Polls inside a single AppleScript so the wait costs one process rather than one per second.
#
# Returns "Connected", "Failed" or "Timeout". A connection that reaches Connecting or
# Authenticating and then falls back to Disconnected has failed, so this reports it
# immediately instead of waiting out the full timeout.
wait_for_connected() {
  local -r conn="${1}"
  local -r timeout="${2}"
  local out status=0
  out=$(
    osascript - "${conn}" "${timeout}" <<'APPLESCRIPT' 2>&1
on run argv
  set connName to item 1 of argv
  set maxSecs to (item 2 of argv) as integer
  set sawProgress to false
  repeat maxSecs times
    set theState to "Missing"
    try
      tell application "Viscosity"
        set theState to state of (first connection whose name is connName)
      end tell
    end try
    if theState is "Connected" then return "Connected"
    if (theState is "Disconnected") and sawProgress then return "Failed"
    if (theState is not "Disconnected") and (theState is not "Missing") then
      set sawProgress to true
    end if
    delay 1
  end repeat
  return "Timeout"
end run
APPLESCRIPT
  ) || status=$?

  if ((status != 0)); then
    log_error "Could not track the connection state:"
    printf '%s\n' "${out}" >&2
    return 1
  fi

  printf '%s' "${out}"
}

# --- 1Password ---------------------------------------------------------------------------

# Fetches username and password for the profile's item. Prints them as two lines.
#
# Scoping the lookup to a vault (and account, when several are signed in) keeps `op` from
# searching every vault, which is both slower and ambiguous when item titles repeat.
fetch_credentials() {
  local -a op_args=(item get "${PROFILE_OP_ITEM}")
  [[ -n "${PROFILE_OP_VAULT}" ]] && op_args+=(--vault "${PROFILE_OP_VAULT}")
  [[ -n "${PROFILE_OP_ACCOUNT}" ]] && op_args+=(--account "${PROFILE_OP_ACCOUNT}")

  local creds user pass
  creds=$(op "${op_args[@]}" --fields label=username,label=password --format json --reveal)
  user=$(printf '%s' "${creds}" | jq -r '[.[] | select(.label=="username") | .value] | @tsv')
  pass=$(printf '%s' "${creds}" | jq -r '[.[] | select(.label=="password") | .value] | @tsv')

  # @tsv above collapses each match set to one line, so a duplicated label shows up as an
  # embedded tab rather than silently selecting whichever value jq emitted first.
  [[ -n "${user}" ]] || die "1Password item '${PROFILE_OP_ITEM}' has no 'username' field"
  [[ -n "${pass}" ]] || die "1Password item '${PROFILE_OP_ITEM}' has no 'password' field"
  [[ "${user}" != *$'\t'* ]] || die "1Password item '${PROFILE_OP_ITEM}' has multiple 'username' fields"
  [[ "${pass}" != *$'\t'* ]] || die "1Password item '${PROFILE_OP_ITEM}' has multiple 'password' fields"

  printf '%s\n%s\n' "${user}" "${pass}"
}

fetch_otp() {
  local -a op_args=(item get "${PROFILE_OP_ITEM}")
  [[ -n "${PROFILE_OP_VAULT}" ]] && op_args+=(--vault "${PROFILE_OP_VAULT}")
  [[ -n "${PROFILE_OP_ACCOUNT}" ]] && op_args+=(--account "${PROFILE_OP_ACCOUNT}")

  local otp
  otp=$(op "${op_args[@]}" --otp)
  [[ -n "${otp}" ]] || die "1Password item '${PROFILE_OP_ITEM}' has no one-time password"
  printf '%s' "${otp}"
}

# --- credential dialog -------------------------------------------------------------------

# Fills Viscosity's credential dialog via macOS Accessibility.
#
# Two things about Viscosity's dialog drive the approach here:
#
#   * The password field's AXRole is AXTextField, exactly like the username field. Only
#     AXSubrole distinguishes it (AXSecureTextField), and the username field has no AXSubrole
#     attribute at all. `role description` would also work but is localized, so it stops
#     matching on a non-English system.
#   * `text fields of window` enumerates the password field *before* the username field, so
#     fields cannot be filled in enumeration order. They are sorted by vertical position
#     instead, which yields the visual top-to-bottom order: username, password, then the
#     challenge field when the profile uses static-challenge.
#
# Credentials are passed in the environment rather than on argv. This keeps them out of
# `ps` output, but note that a process running as the same user can still read another
# process's environment on macOS -- it is a narrowing, not a guarantee.
fill_credentials() {
  local -r user="${1}"
  local -r pass="${2}"
  local -r challenge="${3:-}"

  local out status=0
  out=$(
    VPN_CRED_USER="${user}" VPN_CRED_PASS="${pass}" VPN_CRED_CHALLENGE="${challenge}" \
      osascript <<'APPLESCRIPT' 2>&1
on run
  set theValues to {system attribute "VPN_CRED_USER", system attribute "VPN_CRED_PASS"}
  set theChallenge to system attribute "VPN_CRED_CHALLENGE"
  if theChallenge is not "" then set end of theValues to theChallenge

  tell application "System Events"
    tell process "Viscosity"
      set frontmost to true

      -- Wait up to 15s for the credential dialog to appear.
      repeat 30 times
        if (count of windows) > 0 then exit repeat
        delay 0.5
      end repeat
      if (count of windows) is 0 then error "Credential dialog did not appear"

      -- Pick the window holding a secure text field, so an open Preferences window or
      -- similar does not get mistaken for the credential prompt.
      set theWindow to missing value
      repeat with w in windows
        repeat with tf in text fields of w
          if my isSecure(tf) then
            set theWindow to w
            exit repeat
          end if
        end repeat
        if theWindow is not missing value then exit repeat
      end repeat
      if theWindow is missing value then error "Could not find the credential dialog window"

      set theFields to text fields of theWindow
      if (count of theFields) < (count of theValues) then
        error "Dialog has " & (count of theFields) & " field(s), expected at least " & (count of theValues)
      end if

      -- Insertion-sort the fields top to bottom; enumeration order is not visual order.
      set sorted to {}
      repeat with tf in theFields
        set y to my fieldY(tf)
        set insertAt to (count of sorted) + 1
        repeat with j from 1 to (count of sorted)
          if y < (my fieldY(item j of sorted)) then
            set insertAt to j
            exit repeat
          end if
        end repeat
        if insertAt is 1 then
          set sorted to {contents of tf} & sorted
        else if insertAt > (count of sorted) then
          set end of sorted to contents of tf
        else
          set sorted to (items 1 thru (insertAt - 1) of sorted) & ¬
            {contents of tf} & (items insertAt thru -1 of sorted)
        end if
      end repeat

      repeat with i from 1 to (count of theValues)
        set tf to item i of sorted
        set theValue to item i of theValues
        set focused of tf to true
        delay 0.2
        if my isSecure(tf) then
          -- Secure fields reject `set value`, so the text has to be typed.
          keystroke "a" using {command down}
          keystroke theValue
        else
          set value of tf to theValue
        end if
      end repeat

      delay 0.3
      -- Press the default button rather than one matched by title, which is localized.
      try
        perform action "AXPress" of (value of attribute "AXDefaultButton" of theWindow)
      on error
        key code 36
      end try
    end tell
  end tell
end run

-- Viscosity's password field reports AXRole "AXTextField" just like the username field, so
-- AXSubrole is the only locale-independent way to tell them apart. Non-secure fields do not
-- carry the attribute at all, which raises an error rather than returning missing value.
on isSecure(tf)
  try
    tell application "System Events"
      return (value of attribute "AXSubrole" of tf) is "AXSecureTextField"
    end tell
  on error
    return false
  end try
end isSecure

-- The position has to land in a variable before it is indexed: inside a `tell` block
-- `item 2 of (position of ...)` is parsed as an object specifier and fails with -1700.
on fieldY(tf)
  tell application "System Events"
    set p to position of tf
  end tell
  return item 2 of (p as list)
end fieldY
APPLESCRIPT
  ) || status=$?

  if ((status != 0)); then
    log_error "Could not fill the credential dialog:"
    printf '%s\n' "${out}" >&2
    if [[ "${out}" == *"-1719"* || "${out}" == *"-1743"* || "${out}" == *"assistive"* ]]; then
      log_error "Grant your terminal app Accessibility access in"
      log_error "System Settings -> Privacy & Security -> Accessibility."
    fi
    return 1
  fi
}

# --- AWS Client VPN ----------------------------------------------------------------------

aws_ec2() {
  aws ec2 "$@" \
    --profile "${PROFILE_AWS_PROFILE}" \
    --region "${PROFILE_AWS_REGION}" \
    --output text
}

# Expands the loaded profile's name-template against each endpoint's tags, emitting
# "endpoint_id<TAB>connection_name".
#
# A template is a string with {TagKey} placeholders, e.g. "{Project}-{Stack}" turns tags
# Project=acme, Stack=dev3 into the connection name "acme-dev3". An endpoint
# missing any referenced tag is skipped, since it cannot be named from the template.
expand_endpoint_names() {
  printf '%s' "${1}" | jq -r --arg tpl "${PROFILE_NAME_TEMPLATE}" '
    .[]
    | . as $e
    | ([$e.Tags[]? | {(.Key): .Value}] | add // {}) as $tags
    # Expand every {TagKey} placeholder against this endpoint substituting tags.
    | ($tpl | [scan("\\{([^}]+)\\}")] | map(.[0])) as $keys
    | if ($keys | length) == 0 then empty
      elif any($keys[]; $tags[.] == null or $tags[.] == "") then empty
      else
        ($keys | reduce .[] as $k ($tpl; gsub("\\{" + $k + "\\}"; $tags[$k]))) as $name
        | "\($e.Id)\t\($name)"
      end
  '
}

# Resolves a pinned profile's endpoint id locally, without a second AWS call, by matching
# endpoint-id or endpoint-tag against an already-fetched endpoint list.
pinned_endpoint_id() {
  local -r raw="${1}"
  if [[ -n "${PROFILE_ENDPOINT_ID}" ]]; then
    printf '%s' "${PROFILE_ENDPOINT_ID}"
    return 0
  fi
  local -r tag_key="${PROFILE_ENDPOINT_TAG%%=*}"
  local -r tag_value="${PROFILE_ENDPOINT_TAG#*=}"
  printf '%s' "${raw}" | jq -r --arg k "${tag_key}" --arg v "${tag_value}" '
    .[] | select(any(.Tags[]?; .Key == $k and .Value == $v)) | .Id
  ' | head -n 1
}

# Prints "profile<TAB>endpoint_id<TAB>connection_name<TAB>origin" for everything that can be
# synced, where origin is "pinned" or "template".
#
# Pinned profiles claim their endpoint, which removes it from template-based discovery. That
# is the escape hatch when two endpoints would otherwise expand to the same name: pin one of
# them to an explicit connection name and the other stops being ambiguous.
build_endpoint_map() {
  local rows="" claimed=""
  local profile raw id name

  while read -r profile; do
    load_profile "${profile}"
    [[ "${PROFILE_KIND}" == "aws-clientvpn" ]] || continue

    # shellcheck disable=SC2016 # backticks are JMESPath literal syntax, not command substitution
    raw=$(aws ec2 describe-client-vpn-endpoints \
      --profile "${PROFILE_AWS_PROFILE}" \
      --region "${PROFILE_AWS_REGION}" \
      --output json \
      --query 'ClientVpnEndpoints[?Status.Code==`available`].{Id:ClientVpnEndpointId,Tags:Tags}')

    if [[ -n "${PROFILE_NAME_TEMPLATE}" ]]; then
      while IFS=$'\t' read -r id name; do
        [[ -n "${id}" ]] || continue
        rows+="${profile}"$'\t'"${id}"$'\t'"${name}"$'\t'"template"$'\n'
      done < <(expand_endpoint_names "${raw}")
    else
      id=$(pinned_endpoint_id "${raw}")
      [[ -n "${id}" ]] || id="<unresolved>"
      rows+="${profile}"$'\t'"${id}"$'\t'"${PROFILE_CONNECTION}"$'\t'"pinned"$'\n'
      claimed+="${id}"$'\n'
    fi
  done < <(list_profiles)

  # Drop template rows for endpoints a pinned profile already owns. The claim list is passed
  # through the environment because `awk -v` cannot carry embedded newlines.
  printf '%s' "${rows}" | VPN_CLAIMED="${claimed}" awk -F'\t' '
    BEGIN {
      n = split(ENVIRON["VPN_CLAIMED"], a, "\n")
      for (i = 1; i <= n; i++) if (a[i] != "") owned[a[i]] = 1
    }
    NF == 0 { next }
    $4 == "template" && ($2 in owned) { next }
    { print }
  '
}

resolve_endpoint_id() {
  if [[ -n "${PROFILE_ENDPOINT_ID}" ]]; then
    printf '%s' "${PROFILE_ENDPOINT_ID}"
    return 0
  fi

  local tag_key="${PROFILE_ENDPOINT_TAG%%=*}"
  local tag_value="${PROFILE_ENDPOINT_TAG#*=}"
  [[ -n "${tag_key}" && "${tag_key}" != "${PROFILE_ENDPOINT_TAG}" ]] ||
    die "[${PROFILE_NAME}] endpoint-tag must be KEY=VALUE, got: '${PROFILE_ENDPOINT_TAG}'"

  log_info "Resolving endpoint by tag ${tag_key}=${tag_value} in ${PROFILE_AWS_REGION}..."
  local ids
  # shellcheck disable=SC2016 # backticks are JMESPath literal syntax, not command substitution
  ids=$(aws_ec2 describe-client-vpn-endpoints \
    --filters "Name=tag:${tag_key},Values=${tag_value}" \
    --query 'ClientVpnEndpoints[?Status.Code==`available`].ClientVpnEndpointId')

  local -a matches=()
  # shellcheck disable=SC2206 # deliberate word splitting: aws --output text returns a tab-separated row
  matches=(${ids})

  case "${#matches[@]}" in
  0) die "No available Client VPN endpoint tagged ${tag_key}=${tag_value} in ${PROFILE_AWS_REGION}" ;;
  1) printf '%s' "${matches[0]}" ;;
  *) die "Tag ${tag_key}=${tag_value} matches ${#matches[@]} endpoints: ${matches[*]}. Use endpoint-id instead." ;;
  esac
}

# Builds a .visc bundle from an exported AWS Client VPN configuration.
#
# A bundle is used rather than the raw .ovpn because Viscosity names an imported .ovpn after
# the endpoint's region ("AWS Client VPN - eu-west-1"), which collides as soon as two
# endpoints share a region. A bundle's config.conf carries `#viscosity name`, so the
# connection name is whatever the profile says it is.
build_visc_bundle() {
  local -r raw="${1}"
  local -r bundle="${2}"

  mkdir -p "${bundle}"

  grep -q '^<ca>' "${raw}" || die "Exported configuration has no inline <ca> block"
  awk '/^<ca>/ { inside = 1; next } /^<\/ca>/ { inside = 0; next } inside' "${raw}" >"${bundle}/ca.crt"
  [[ -s "${bundle}/ca.crt" ]] || die "Exported configuration has an empty <ca> block"

  {
    printf '#-- Generated by vpn-connect from AWS Client VPN --#\n'
    printf '#viscosity name %s\n' "${PROFILE_CONNECTION}"
    printf '#viscosity protocol openvpn\n'
    if grep -q '^auth-federate' "${raw}"; then
      # Viscosity's own name for the AWS SAML browser flow. This is what it writes when it
      # imports an `auth-federate` config itself.
      printf '#viscosity web-authentication-custom aws\n'
    fi
    # Replace the inline <ca> block with a reference to the extracted file, and drop
    # auth-federate now that it is expressed as a #viscosity directive.
    awk '
      /^<ca>/      { inside = 1; print "ca ca.crt"; next }
      /^<\/ca>/    { inside = 0; next }
      inside       { next }
      /^auth-federate[[:space:]]*$/ { next }
      { print }
    ' "${raw}"
  } >"${bundle}/config.conf"
}

sync_profile() {
  local -r known_endpoint_id="${1:-}"

  [[ "${PROFILE_KIND}" == "aws-clientvpn" ]] ||
    die "[${PROFILE_NAME}] --sync only applies to kind = aws-clientvpn"

  require_command aws "brew install awscli"
  require_viscosity

  local snapshot
  snapshot=$(viscosity_snapshot) || return 1
  if [[ "$(connection_state "${PROFILE_CONNECTION}" "${snapshot}")" != "Missing" ]]; then
    log_error "Viscosity already has a connection named '${PROFILE_CONNECTION}'."
    log_error "Re-importing would create a duplicate rather than replace it."
    log_error "Delete it first: Viscosity -> Preferences -> Connections, then re-run --sync."
    return 1
  fi

  local endpoint_id="${known_endpoint_id}"
  [[ -n "${endpoint_id}" ]] || endpoint_id=$(resolve_endpoint_id)

  local work
  work=$(mktemp -d) || die "Could not create a temporary directory"
  # The bundle holds no secrets for SAML endpoints, but a mutual-auth export would, so the
  # working directory is removed on every exit path.
  # shellcheck disable=SC2064 # expand work now: the path must survive into the trap
  trap "rm -rf '${work}'" EXIT

  log_info "Exporting configuration for ${endpoint_id}..."
  (
    umask 077
    aws_ec2 export-client-vpn-client-configuration --client-vpn-endpoint-id "${endpoint_id}"
  ) >"${work}/raw.ovpn"
  [[ -s "${work}/raw.ovpn" ]] || die "AWS returned an empty configuration for ${endpoint_id}"

  local bundle="${work}/${PROFILE_CONNECTION}.visc"
  (
    umask 077
    build_visc_bundle "${work}/raw.ovpn" "${bundle}"
  )

  log_info "Importing '${PROFILE_CONNECTION}' into Viscosity..."
  log_info "Viscosity will show a 'Connection Imported' notice -- it is informational, dismiss it."
  open -a Viscosity "${bundle}"

  # Viscosity registers the connection before that notice is dismissed, so this only waits for
  # the import itself -- which must finish before the trap removes the source bundle.
  local i=0
  while ((i < IMPORT_TIMEOUT)); do
    snapshot=$(viscosity_snapshot) || return 1
    if [[ "$(connection_state "${PROFILE_CONNECTION}" "${snapshot}")" != "Missing" ]]; then
      # Suggest the connection name, not the profile name: for a template-discovered endpoint
      # the profile covers many endpoints and is not what you connect to.
      log_info "Imported '${PROFILE_CONNECTION}'. Connect with: ${0##*/} ${PROFILE_CONNECTION}"
      return 0
    fi
    sleep 1
    i=$((i + 1))
  done

  die "Viscosity did not register '${PROFILE_CONNECTION}' within ${IMPORT_TIMEOUT}s. Was the import prompt dismissed?"
}

# --- target resolution -------------------------------------------------------------------

is_profile() {
  list_profiles | grep -qxF "${1}"
}

# Reads a connection's stored OpenVPN config to work out how it authenticates. This keeps
# `vpn <discovered-name>` working without a profile section or an AWS round-trip.
viscosity_connection_auth() {
  local -r conn="${1}"
  local dir config name
  for dir in "${HOME}/Library/Application Support/Viscosity/OpenVPN/"*/; do
    config="${dir}config.conf"
    [[ -r "${config}" ]] || continue
    name=$(awk '/^#viscosity name /{ sub(/^#viscosity name /, ""); gsub(/^"|"$/, ""); print; exit }' "${config}")
    [[ "${name}" == "${conn}" ]] || continue
    if grep -q '^#viscosity web-authentication' "${config}"; then
      printf 'web'
    else
      printf 'none'
    fi
    return 0
  done
  printf 'none'
}

# Accepts either a profile section name or the name of a connection already in Viscosity.
# The latter is what makes `vpn acme-dev3` work for a template-discovered endpoint
# that has no section of its own.
resolve_connect_target() {
  local -r target="${1:-}"

  if [[ -z "${target}" ]] || is_profile "${target}"; then
    load_profile "${target}"
    return 0
  fi

  require_viscosity
  local snapshot
  snapshot=$(viscosity_snapshot) || return 1

  if [[ "$(connection_state "${target}" "${snapshot}")" == "Missing" ]]; then
    log_error "No profile or Viscosity connection named '${target}'."
    log_error "Profiles: $(list_profiles | paste -sd' ' -)"
    log_error "If it is an AWS endpoint, import it first: ${0##*/} --sync ${target}"
    return 1
  fi

  # Synthesise a profile for a connection Viscosity already knows about.
  PROFILE_NAME="${target}"
  PROFILE_KIND="viscosity"
  PROFILE_CONNECTION="${target}"
  PROFILE_AUTH=$(viscosity_connection_auth "${target}")
  PROFILE_OTP_MODE="none"
  PROFILE_TIMEOUT="${WEB_AUTH_TIMEOUT}"
}

# Accepts a profile section name, or a connection name produced by a profile's name-template.
resolve_sync_target() {
  local -r target="${1}"

  if is_profile "${target}"; then
    load_profile "${target}"
    sync_profile
    return
  fi

  require_command aws "brew install awscli"
  require_command jq "brew install jq"
  log_info "Looking up '${target}' across AWS Client VPN profiles..."

  local map
  map=$(build_endpoint_map)

  local -a hits=()
  local line
  while IFS= read -r line; do
    [[ -n "${line}" ]] && hits+=("${line}")
  done < <(printf '%s\n' "${map}" | awk -F'\t' -v n="${target}" '$3 == n')

  case "${#hits[@]}" in
  0)
    log_error "No profile or discoverable endpoint named '${target}'."
    log_error "Available:"
    printf '%s\n' "${map}" | awk -F'\t' 'NF { printf "    %-34s (%s, %s)\n", $3, $1, $4 }' >&2
    return 1
    ;;
  1) : ;;
  *)
    log_error "'${target}' matches ${#hits[@]} endpoints:"
    printf '%s\n' "${hits[@]}" | awk -F'\t' '{ printf "    %s  (profile %s)\n", $2, $1 }' >&2
    log_error "Use a more specific name-template, or pin one of them to its own profile"
    log_error "section with endpoint-id plus connection -- a pinned endpoint drops out of"
    log_error "template discovery, which makes the other name unambiguous again."
    return 1
    ;;
  esac

  local hit_profile hit_id hit_name
  IFS=$'\t' read -r hit_profile hit_id hit_name _ <<<"${hits[0]}"

  load_profile "${hit_profile}"
  PROFILE_CONNECTION="${hit_name}"
  sync_profile "${hit_id}"
}

discover() {
  require_command aws "brew install awscli"
  require_command jq "brew install jq"
  require_viscosity

  local snapshot
  snapshot=$(viscosity_snapshot) || return 1

  local map
  map=$(build_endpoint_map)
  [[ -n "${map}" ]] || {
    log_warn "No aws-clientvpn profiles defined in ${CONFIG_FILE}"
    return 0
  }

  printf '%-32s %-30s %-10s %s\n' "CONNECTION" "PROFILE" "ORIGIN" "IMPORTED"
  local profile id name origin state
  while IFS=$'\t' read -r profile id name origin; do
    [[ -n "${name}" ]] || continue
    state=$(connection_state "${name}" "${snapshot}")
    printf '%-32s %-30s %-10s %s\n' "${name}" "${profile}" "${origin}" \
      "$([[ "${state}" == "Missing" ]] && printf 'no' || printf 'yes')"
  done <<<"${map}"
}

# --- actions -----------------------------------------------------------------------------

connect_profile() {
  require_viscosity

  local snapshot
  snapshot=$(viscosity_snapshot) || return 1

  local state
  state=$(connection_state "${PROFILE_CONNECTION}" "${snapshot}")

  case "${state}" in
  Connected)
    log_info "Already connected to '${PROFILE_CONNECTION}'."
    return 0
    ;;
  Missing)
    if [[ "${PROFILE_KIND}" == "aws-clientvpn" ]]; then
      die "Viscosity has no connection named '${PROFILE_CONNECTION}'. Import it with: ${0##*/} --sync ${PROFILE_NAME}"
    fi
    die "Viscosity has no connection named '${PROFILE_CONNECTION}'."
    ;;
  *)
    # Disconnected, or already Connecting/Authenticating: carry on and let Viscosity settle it.
    :
    ;;
  esac

  local user="" pass="" otp=""
  if [[ "${PROFILE_AUTH}" == "op-dialog" ]]; then
    require_command op "brew install 1password-cli"
    require_command jq "brew install jq"

    log_info "Fetching credentials from 1Password..."
    {
      read -r user
      read -r pass
    } < <(fetch_credentials)
  fi

  log_info "Connecting to '${PROFILE_CONNECTION}'..."
  viscosity_connect "${PROFILE_CONNECTION}"

  if [[ "${PROFILE_AUTH}" == "op-dialog" ]]; then
    if [[ "${PROFILE_OTP_MODE}" != "none" ]]; then
      # Fetched after the connection is triggered: TOTP codes rotate every 30s, so fetching
      # earlier risks the code expiring while the dialog is still appearing.
      log_info "Fetching one-time password from 1Password..."
      otp=$(fetch_otp)
    fi

    log_info "Filling credentials..."
    case "${PROFILE_OTP_MODE}" in
    append) fill_credentials "${user}" "${pass}${otp}" ;;
    challenge) fill_credentials "${user}" "${pass}" "${otp}" ;;
    none) fill_credentials "${user}" "${pass}" ;;
    *) die "[${PROFILE_NAME}] unknown otp-mode: '${PROFILE_OTP_MODE}' (expected append, challenge or none)" ;;
    esac
    user="" pass="" otp=""
  elif [[ "${PROFILE_AUTH}" == "web" ]]; then
    log_info "Viscosity is handling authentication in your browser..."
  fi

  log_info "Waiting for connection (up to ${PROFILE_TIMEOUT}s)..."
  local result
  result=$(wait_for_connected "${PROFILE_CONNECTION}" "${PROFILE_TIMEOUT}")

  case "${result}" in
  Connected) log_info "Connected to '${PROFILE_CONNECTION}'." ;;
  Failed) die "'${PROFILE_CONNECTION}' returned to Disconnected. Check Viscosity's log for the reason." ;;
  *) die "Timed out after ${PROFILE_TIMEOUT}s. Check Viscosity's log, or raise 'timeout' for this profile." ;;
  esac
}

down_profile() {
  require_viscosity
  viscosity_disconnect "${PROFILE_CONNECTION}"
  log_info "Disconnected '${PROFILE_CONNECTION}'."
}

down_all() {
  require_viscosity
  osascript -e 'tell application "Viscosity" to disconnectall' >/dev/null
  log_info "All VPN connections disconnected."
}

status_line() {
  local -r conn="${1}"
  local -r owner="${2}"
  local -r snapshot="${3}"
  local state time detail
  state=$(connection_state "${conn}" "${snapshot}")
  detail="${state}"
  if [[ "${state}" == "Connected" ]]; then
    time=$(connection_time "${conn}" "${snapshot}")
    [[ -n "${time}" ]] && detail="Connected (${time})"
  fi
  printf '%-32s %-24s %s\n' "${conn}" "${owner}" "${detail}"
}

# Lists what Viscosity actually has rather than iterating profiles, because a profile using
# name-template stands for many connections and knowing which ones would cost an AWS call.
# Connections imported by --sync therefore show up here without one.
status() {
  local -r only="${1:-}"
  require_viscosity

  local snapshot
  snapshot=$(viscosity_snapshot) || return 1

  if [[ -n "${only}" ]]; then
    if is_profile "${only}"; then
      load_profile "${only}"
      [[ -n "${PROFILE_CONNECTION}" ]] ||
        die "[${only}] uses name-template and covers several connections; run --discover, or name one of them"
      status_line "${PROFILE_CONNECTION}" "${only}" "${snapshot}"
    else
      status_line "${only}" "-" "${snapshot}"
    fi
    return 0
  fi

  # Map connection name -> owning profile, for profiles that name exactly one connection.
  local owners="" profile
  while read -r profile; do
    load_profile "${profile}"
    [[ -n "${PROFILE_CONNECTION}" ]] || continue
    owners+="${PROFILE_CONNECTION}"$'\t'"${profile}"$'\n'
  done < <(list_profiles)

  printf '%-32s %-24s %s\n' "CONNECTION" "PROFILE" "STATE"
  local name state time detail owner
  while IFS=$'\t' read -r name state time; do
    [[ -n "${name}" ]] || continue
    owner=$(printf '%s' "${owners}" | awk -F'\t' -v n="${name}" '$1 == n { print $2; exit }')
    detail="${state}"
    [[ "${state}" == "Connected" && -n "${time}" ]] && detail="Connected (${time})"
    printf '%-32s %-24s %s\n' "${name}" "${owner:--}" "${detail}"
  done <<<"${snapshot}"
}

# --- main --------------------------------------------------------------------------------

main() {
  local action="connect"
  local target=""
  local all=false

  while (($#)); do
    case "${1}" in
    -s | --status)
      action="status"
      shift
      ;;
    -d | --down)
      action="down"
      shift
      ;;
    --sync)
      action="sync"
      shift
      ;;
    --discover)
      action="discover"
      shift
      ;;
    -l | --list)
      action="list"
      shift
      ;;
    --all)
      all=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      log_error "Unknown option: '${1}'"
      usage >&2
      exit 1
      ;;
    *)
      [[ -z "${target}" ]] || {
        log_error "Unexpected argument: '${1}'"
        usage >&2
        exit 1
      }
      target="${1}"
      shift
      ;;
    esac
  done

  require_config

  # Exit rather than resume, so Ctrl+C during a wait stops the script instead of letting the
  # loop carry on.
  trap 'log_warn "Interrupted."; exit 130' INT TERM

  case "${action}" in
  list)
    list_profiles
    ;;
  status)
    status "${target}"
    ;;
  down)
    if [[ "${all}" == true ]]; then
      down_all
    else
      load_profile "${target}"
      down_profile
    fi
    ;;
  discover)
    discover
    ;;
  sync)
    [[ -n "${target}" ]] || die "--sync requires a profile or connection name"
    resolve_sync_target "${target}"
    ;;
  connect)
    resolve_connect_target "${target}"
    connect_profile
    ;;
  *)
    die "Internal error: unhandled action '${action}'"
    ;;
  esac
}

main "$@"
